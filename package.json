{
  "name": "resane-miim-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Static Persian portfolio with a Supabase-backed command room",
  "scripts": {
    "build:cloud": "esbuild lib/cloud.js --bundle --minify --format=iife --outfile=vendor/miim-cloud.js --legal-comments=linked --supported:template-literal=false",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/admin.browser.cjs && node tests/skills.browser.cjs",
    "version:assets": "node scripts/version-assets.cjs",
    "build": "npm run build:cloud && npm run version:assets",
    "build:edge": "esbuild supabase/functions/miim-rubika/index.mjs --bundle --minify --format=esm --platform=neutral --charset=utf8 --supported:template-literal=false --outfile=.cache/miim-rubika-deploy.mjs",
    "test:skills:browser": "node tests/skills.browser.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
