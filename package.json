{
  "name": "resane-miim-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Static Persian portfolio with a Supabase-backed command room",
  "scripts": {
    "build:cloud": "esbuild lib/cloud.js --bundle --minify --format=iife --outfile=vendor/miim-cloud.js --legal-comments=linked",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/admin.browser.cjs",
    "version:assets": "node scripts/version-assets.cjs",
    "build": "npm run build:cloud && npm run version:assets"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
